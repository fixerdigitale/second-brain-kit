{
  "description": "second-brain: all'avvio di una sessione propone la rimisura, una volta sola, dal giorno 14 dopo il piano. Se nella cartella non c'e' lo stato dell'onboarding esce subito, senza nemmeno avviare Python.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR:-.}/second-brain/.onboarding/stato.json\" ] || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/rimisura.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/rimisura.py\" 2>/dev/null || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/rimisura.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
